# Copy to .env.local and fill in (Vite exposes only vars prefixed with VITE_).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Default bus shown on dashboard / track page
VITE_DEFAULT_BUS_ID=bus_07

# Driver page: Edge Function that accepts POST { lat, lng, speed_kmh } with Bearer JWT
VITE_DRIVER_FUNCTION_URL=https://your-project.functions.supabase.co/driver-location

# Vercel: add the same VITE_* variables under Project → Settings → Environment Variables
# so the production build embeds your Supabase project (required for a dynamic app).

# Multi-tenant (schools): apply migration 20260410210000_multi_tenant_schools.sql + seed.
# Create Auth users in Supabase, then link parents:
#   update public.parent_profiles pp set user_id = u.id from auth.users u
#   where lower(u.email) = lower(pp.login_email);
# Staff / drivers: insert into school_members (school_id, user_id, role) values
#   ('00000000-0000-0000-0000-000000000001', '<auth-user-uuid>', 'school_admin');
# Your Edge Function that writes bus_state should set school_id (and bus_id) per tenant.
