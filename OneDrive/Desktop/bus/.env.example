# Copy to .env.local and fill in (Vite exposes only vars prefixed with VITE_)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Default bus shown on dashboard / track page
VITE_DEFAULT_BUS_ID=bus_07

# Driver page: Edge Function that accepts POST { lat, lng, speed_kmh } with Bearer JWT
VITE_DRIVER_FUNCTION_URL=https://your-project.functions.supabase.co/driver-location
