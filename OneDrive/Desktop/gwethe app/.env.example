# Africa's Talking credentials
AT_API_KEY=your_africastalking_api_key
AT_USERNAME=your_africastalking_username
AT_SENDER_ID=GWETHE

# WhatsApp Business API (Meta Graph API — not Africa's Talking)
WA_API_KEY=your_whatsapp_api_key
WA_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Order webhooks: require Authorization: Bearer <secret> or X-Webhook-Secret: <secret>
# Required when NODE_ENV=production
WEBHOOK_SECRET=generate_a_long_random_string

# Optional: if your M-Pesa URL is hit via a proxy that adds the same auth headers
MPESA_CALLBACK_SECRET=

# App
PORT=3000
NODE_ENV=development
