# Copy this file to .env and fill in your values
# For Netlify: add these in Site settings → Environment variables

# Required in production — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-at-least-32-chars

# Magic link emails (sign up / password reset)
# Get key at https://resend.com — free tier: 100 emails/day
RESEND_API_KEY=re_xxxxxxxxxxxx

# Google sign-in
# Get at https://console.cloud.google.com → APIs & Services → Credentials → Create OAuth 2.0 Client ID (Web)
GOOGLE_CLIENT_ID=xxxxxx.apps.googleusercontent.com

# Admin user IDs (comma-separated). User ID 1 is admin by default.
ADMIN_USER_IDS=1
